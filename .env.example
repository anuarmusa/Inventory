# Copy to .env and fill in. Never commit .env.

# PostgreSQL password, used by both the db container and the server.
POSTGRES_PASSWORD=change-me

# Local time for expiry dates and nightly jobs.
TZ=Asia/Kuala_Lumpur

# Database URL for running the server directly on the dev PC (pnpm dev).
# Inside Docker Compose the server uses the "db" host instead.
DATABASE_URL=postgres://inventory:change-me@localhost:5432/inventory

# Port the server listens on when run with pnpm dev.
PORT=3000

# Optional: the address put in pairing offers, e.g. http://192.168.1.10. Default: the address
# the download page was opened with.
PUBLIC_ADDRESS=
