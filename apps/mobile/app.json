{
  "expo": {
    "name": "Inventory",
    "slug": "inventory",
    "version": "0.1.0",
    "scheme": "inventory",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.household.inventory",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Inventory to use the camera to scan barcodes and QR codes.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Inventory to use your photos to add pictures of Assets and receipts.",
          "cameraPermission": "Allow Inventory to use the camera to take pictures of Assets and receipts."
        }
      ],
      "expo-notifications",
      "./plugins/with-short-native-build-dir"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
